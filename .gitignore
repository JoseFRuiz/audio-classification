# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
env/
venv/
.venv/

# PyTorch model weights
*.pt

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Large data arrays & model files
*.npy
*.npz
*.h5

# Distribution / packaging
build/
dist/
*.egg-info/

# OS or editor cruft
.DS_Store
Thumbs.db

# Constantly changing files
multi_gpu.out
multi_gpu2.out
multi_gpu3.out
*.out

# Core dump files (from crashes)
core.*
*.core

# Large log files
*.log
*.err

# Temporary files
*.tmp
*.temp

# Checkpoint files (can be large)
*.ckpt
*.pth

# Embeddings directory (can be very large)
embeddings/

# SLURM output files
slurm-*.out

# Ignore Python virtual environment
pytorch_env/

gru_036/metrics/version_1/metrics.csv
gru_037/metrics/version_1/metrics.csv
